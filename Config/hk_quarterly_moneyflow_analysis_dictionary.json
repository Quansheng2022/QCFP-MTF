    ],
    "business_rules": [
      {
        "rule": "每季度每个股票只有一条记录",
        "description": "同一股票在同一个季度只有一条资金流分析数据"
      },
      {
        "rule": "机构/散户资金流",
        "description": "institutional_flow = extra_large + large；individual_flow = medium + small"
      },
      {
        "rule": "移动平均",
        "description": "inst_5ma / ind_5ma 为最近5个季度移动平均"
      },
      {
        "rule": "IDR/FBI",
        "description": "idr = |机构|/(|机构|+|散户|)；fbi = (机构-散户)/(|机构|+|散户|)"
      }
