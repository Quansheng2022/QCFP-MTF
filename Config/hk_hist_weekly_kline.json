    "business_rules": [
      {
        "rule": "每个股票每周只有一条记录",
        "description": "数据按周去重，同一股票在同一周只有一条交易数据"
      },
      {
        "rule": "价格精度",
        "description": "价格数据保留4位小数"
      },
      {
        "rule": "数据完整性",
        "description": "所有周K线数据应包含完整的OHLC（开高低收）和成交量信息"
      },
      {
        "rule": "索引优化",
        "description": "使用复合索引 (stock_code, date) 优化查询性能"
      },
      {
        "rule": "周数据周期",
        "description": "周K线数据以自然周为周期，周五（或最后一个交易日）为周数据点"
      }
    ]
