    "macro_data_hist": {
      "description": "宏观经济历史数据 - 包含美国国债收益率、VIX指数、美元指数等",
      "table_type": "macro_data",
      "update_frequency": "daily",
      "data_source": "FRED API + Yahoo Finance",
      "columns": {
        "date": {
          "data_type": "DATE",
          "sqlite_type": "TEXT",
          "python_type": "datetime.date",
          "description": "交易日期",
          "nullable": false,
          "primary_key": true,
          "example": "2026-07-09",
          "format": "YYYY-MM-DD"
        },
        "DXY": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "美元指数 (DXY) - 衡量美元对一篮子货币的强弱",
          "nullable": true,
          "example": "105.50",
          "source": "Yahoo Finance DX-Y.NYB",
          "interpretation": ">108高风险, >105承压"
        },
        "US2Y": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "美国2年期国债收益率",
          "nullable": true,
          "example": "4.25",
          "source": "FRED DGS2",
          "unit": "%"
        },
        "US10Y": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "美国10年期国债收益率 (全球资产定价之锚)",
          "nullable": true,
          "example": "4.50",
          "source": "FRED DGS10",
          "unit": "%",
          "interpretation": ">5% 风险资产受压"
        },
        "US30Y": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "美国30年期国债收益率",
          "nullable": true,
          "example": "4.75",
          "source": "FRED DGS30",
          "unit": "%",
          "interpretation": ">5.2% 长债风险"
        },
        "VIX": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "VIX恐慌指数 (芝加哥期权交易所波动率指数)",
          "nullable": true,
          "example": "28.50",
          "source": "FRED VIXCLS",
          "interpretation": ">35恐慌, >25风险下降"
        },
        "USDCNY": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "美元兑人民币汇率",
          "nullable": true,
          "example": "7.25",
          "source": "FRED DEXCHUS"
        },
        "FEDFUNDS": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "美联储联邦基金利率",
          "nullable": true,
          "example": "5.50",
          "source": "FRED FEDFUNDS",
          "unit": "%"
        },
        "SOFR": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "担保隔夜融资利率 (SOFR)",
