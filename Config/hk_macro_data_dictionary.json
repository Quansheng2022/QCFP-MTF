          "example": "3.20",
          "source": "FRED CPILFESL",
          "unit": "%"
        }
      },
      "indexes": [
        {
          "name": "idx_macro_date",
          "columns": ["date"],
          "type": "UNIQUE"
        }
      ],
      "usage_example": "SELECT date, DXY, US10Y, VIX FROM macro_data_hist WHERE date >= '2026-01-01' ORDER BY date DESC",
      "notes": "所有收益率数据以百分比(%)表示，例如4.25表示4.25%"
    },

