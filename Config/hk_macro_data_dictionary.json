          "primary_key": true,
          "example": "2026-07-09",
          "format": "YYYY-MM-DD"
        },
        "open": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "开盘价",
          "nullable": true,
          "example": "18500.00"
        },
        "close": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "收盘价",
          "nullable": true,
          "example": "18500.50"
        },
        "high": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "最高价",
          "nullable": true,
          "example": "18600.00"
        },
        "low": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "最低价",
          "nullable": true,
          "example": "18400.00"
        },
        "pe_ratio": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "市盈率",
          "nullable": true,
          "example": "12.5",
          "unit": "倍"
        },
        "turnover_rate": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "换手率",
          "nullable": true,
          "example": "0.35",
          "unit": "%"
        },
        "volume": {
          "data_type": "INTEGER",
          "sqlite_type": "INTEGER",
          "python_type": "int",
          "description": "成交量 (股)",
          "nullable": true,
          "example": "2500000000"
        },
        "turnover": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "成交额 (港元)",
          "nullable": true,
          "example": "125000000000"
        },
        "change_rate": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "涨跌幅",
          "nullable": true,
          "example": "1.25",
          "unit": "%"
        },
        "last_close": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "昨收价",
          "nullable": true,
          "example": "18275.00"
        }
      },
      "indexes": [
        {
          "name": "idx_hsi_date",
          "columns": ["date"],
          "type": "UNIQUE"
        },
        {
          "name": "idx_hsi_code",
          "columns": ["code"]
        }
      ],
      "usage_example": "SELECT date, open, close, high, low, volume FROM hk_idx_hsi WHERE date >= '2026-01-01' ORDER BY date DESC"
    },

