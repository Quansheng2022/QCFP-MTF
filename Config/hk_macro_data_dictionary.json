  "tables": {
    "hk_idx_hist": {
      "description": "港股指数合并历史数据 - 包含所有主要指数的收盘价和南向资金净流入",
      "table_type": "merged_data",
      "update_frequency": "daily",
      "data_source": "富途API + AkShare",
      "columns": {
        "date": {
          "data_type": "DATE",
          "sqlite_type": "TEXT",
          "python_type": "datetime.date",
          "description": "交易日期",
          "nullable": false,
          "primary_key": true,
          "example": "2026-07-09",
          "format": "YYYY-MM-DD"
        },
        "HSI": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "恒生指数收盘价",
          "nullable": true,
          "example": "18500.50",
          "source": "富途API HK.800000"
        },
        "HSCEI": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "恒生国企指数收盘价 (H股指数)",
          "nullable": true,
          "example": "6500.25",
          "source": "富途API HK.800100"
        },
        "HSTECH": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "恒生科技指数收盘价",
          "nullable": true,
          "example": "4200.75",
          "source": "富途API HK.800700"
        },
        "HSNF": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "恒生金融分类指数收盘价",
          "nullable": true,
          "example": "28000.00",
          "source": "富途API HK.800152"
        },
        "HSNP": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "恒生地产分类指数收盘价",
          "nullable": true,
          "example": "22000.00",
          "source": "富途API HK.800153"
        },
        "HSNC": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "恒生工商分类指数收盘价",
          "nullable": true,
          "example": "15000.00",
          "source": "富途API HK.800154"
        },
        "HSNU": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "恒生公用事业分类指数收盘价",
          "nullable": true,
          "example": "45000.00",
          "source": "富途API HK.800155"
        },
        "HSBIO": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "恒生生物科技指数收盘价",
          "nullable": true,
          "example": "2800.00",
          "source": "富途API HK.800187"
        },
        "VHSI": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "恒指波幅指数 (香港恐慌指数)",
          "nullable": true,
          "example": "25.50",
          "source": "富途API HK.800125",
          "interpretation": "数值越高，市场恐慌程度越高"
        },
        "SouthboundFlow": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "南向资金净流入 (亿元)",
          "nullable": true,
          "example": "45.67",
          "source": "AkShare stock_hsgt_hist_em",
          "interpretation": "正值表示资金流入港股，负值表示流出"
        }
      },
      "indexes": [
        {
          "name": "idx_hk_idx_date",
          "columns": ["date"],
          "type": "UNIQUE"
        }
      ],
      "usage_example": "SELECT date, HSI, HSCEI, SouthboundFlow FROM hk_idx_hist WHERE date >= '2026-01-01' ORDER BY date DESC"
    },
    
    "hk_idx_hsi": {
