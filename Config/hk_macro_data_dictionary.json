          "example": "5.35",
          "source": "FRED SOFR",
          "unit": "%"
        },
        "UNRATE": {
          "data_type": "REAL",
          "sqlite_type": "REAL",
          "python_type": "float",
          "description": "美国失业率",
          "nullable": true,
          "example": "3.80",
          "source": "FRED UNRATE",
          "unit": "%"
        },
